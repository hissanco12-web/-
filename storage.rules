rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'nYe0azkrCYMaJ7yOrkEfkYMQ1K62' ||
        request.auth.token.email == 'smthysan@gmail.com' ||
        (
          firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) &&
          firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.email == request.auth.token.email &&
          firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.active == true
        )
      );
    }
    match /media/public/{category}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && request.resource != null && request.resource.size <= 5 * 1024 * 1024 && request.resource.contentType.matches('^image/(jpeg|png|webp|avif)$');
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
